# Copy into an ignored local environment file. Generate a unique secret locally.
# Never reuse the historical signing key from source control.
DJANGO_SECRET_KEY=replace-with-a-new-random-secret
DJANGO_DEBUG=false
# Non-Docker servers use this allowlist directly (hostnames/IPs, no scheme/port).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Development Compose appends this IP to the allowlist, including for existing .env files.
# Omit to use the current laptop's 192.168.1.73 default; empty disables the addition.
SRISU_DEV_LAN_HOST=192.168.1.73
# Recreate after configuration changes: docker-compose up -d --force-recreate web
WEBSOCKET_ALLOWED_ORIGINS=
POSTGRES_DB=srisu_development
POSTGRES_USER=srisu_development
POSTGRES_PASSWORD=replace-locally
POSTGRES_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
TWILIO_ACCOUNT_SID=configure-locally
TWILIO_AUTH_TOKEN=configure-locally
TWILIO_PHONE_NUMBER=configure-locally
# Development Compose mocks SMS delivery by default. Normal settings default to Twilio.
# Uncomment to send real SMS again after restoring the provider account:
# OTP_MOCK_DELIVERY=false
# Development Compose uses 123456 for every requested mock OTP (synthetic test code).
# Optional override; ignored when OTP_MOCK_DELIVERY=false:
# OTP_MOCK_CODE=123456

# Set false only after the announced legacy-client cutoff.
AUTH_ACCEPT_LEGACY_TOKENS=true
OTP_GLOBAL_HOURLY_LIMIT=100
OTP_IP_HOURLY_LIMIT=10

# Chat v2 stays fail-closed until a reviewed client protocol adapter is deployed.
CHAT_V2_ENCRYPTED_WRITES_ENABLED=false
CHAT_V2_PROTOCOL_STATUS=adapter_required
# Synthetic test harness only. Never enable in a user-serving environment.
CHAT_V2_TEST_ADAPTER_ENABLED=false
# Comma-separated database user IDs; both room participants must be listed.
CHAT_V2_ALLOWED_USER_IDS=
CHAT_V2_REQUIRE_DEVICE_SESSION=true
CHAT_V2_MAX_ENVELOPE_BYTES=65536
# Client plaintext policy only; the server cannot inspect plaintext.
CHAT_V2_MAX_MESSAGE_PLAINTEXT_BYTES=4000
CHAT_V2_MAX_ATTACHMENT_BYTES=15728640
CHAT_LEGACY_MEDIA_TTL_SECONDS=86400
CHAT_MEDIA_CLEANUP_BATCH_SIZE=100
CHAT_V2_OUTBOX_RETENTION_SECONDS=604800
# Separate review gate; text pilot enablement must not enable attachments.
CHAT_V2_ATTACHMENT_STAGING_ENABLED=false
