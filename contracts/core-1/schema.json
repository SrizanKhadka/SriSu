{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srisu.invalid/contracts/core-1",
  "title": "SriSu core-1 additive contract (v1 resources)",
  "x-status-codes": {
    "400": "validation_failed",
    "401": "unauthenticated",
    "403": "forbidden",
    "404": "not_found",
    "405": "method_not_allowed",
    "409": "conflict",
    "410": "cursor_expired",
    "413": "payload_too_large",
    "415": "unsupported_media_type",
    "429": "rate_limited",
    "500": "server_error",
    "503": "temporarily_unavailable"
  },
  "$defs": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "retryable": {
          "type": "boolean"
        },
        "retry_after_seconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "code",
        "message",
        "fields",
        "retryable"
      ],
      "additionalProperties": true
    },
    "httpError": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/error"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "server_time": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "error",
        "request_id",
        "server_time"
      ],
      "additionalProperties": true
    },
    "interest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "category": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "label"
              ],
              "additionalProperties": true
            }
          ]
        },
        "created_date": {
          "type": "string",
          "format": "date-time"
        },
        "updated_date": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "created_date",
        "updated_date"
      ],
      "additionalProperties": true
    },
    "interests": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "interests": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/interest"
              }
            }
          },
          "required": [
            "interests"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "message",
        "data"
      ],
      "additionalProperties": true
    },
    "message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "chat_room_id": {
          "type": "string",
          "format": "uuid"
        },
        "sender_id": {
          "type": "integer",
          "minimum": 1
        },
        "receiver_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "message_type": {
          "type": "string"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "media_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "sticker_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "medias": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "media_url": {
                "type": "string"
              },
              "uploaded_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "id",
              "media_url",
              "uploaded_at"
            ],
            "additionalProperties": true
          }
        },
        "reply_to": {
          "type": [
            "object",
            "null"
          ]
        },
        "is_deleted": {
          "type": "boolean"
        },
        "is_read": {
          "type": "boolean"
        },
        "is_delivered": {
          "type": "boolean"
        },
        "is_edited": {
          "type": "boolean"
        },
        "is_sent": {
          "type": "boolean"
        },
        "deleted_message": {
          "type": [
            "string",
            "null"
          ]
        },
        "delete_option": {
          "type": [
            "string",
            "null"
          ]
        },
        "reactions": {
          "type": [
            "object",
            "null"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "chat_room_id",
        "sender_id",
        "receiver_id",
        "message_type",
        "text",
        "media_url",
        "sticker_url",
        "medias",
        "reply_to",
        "is_deleted",
        "is_read",
        "is_delivered",
        "is_edited",
        "is_sent",
        "deleted_message",
        "delete_option",
        "reactions",
        "timestamp"
      ],
      "additionalProperties": true
    },
    "historyData": {
      "type": "object",
      "properties": {
        "chat_room_id": {
          "type": "string",
          "format": "uuid"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "chat_room_id",
        "messages",
        "has_more",
        "next_cursor"
      ],
      "additionalProperties": true
    },
    "history": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/historyData"
        }
      },
      "required": [
        "message",
        "data"
      ],
      "additionalProperties": true
    },
    "room": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "last_message": {
          "anyOf": [
            {
              "$ref": "#/$defs/message"
            },
            {
              "type": "null"
            }
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "updated_at"
      ],
      "additionalProperties": true
    },
    "rooms": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "chat_rooms": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/room"
              }
            },
            "has_more": {
              "type": "boolean"
            },
            "next_cursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "chat_rooms",
            "has_more",
            "next_cursor",
            "limit"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "message",
        "data"
      ],
      "additionalProperties": true
    },
    "socketError": {
      "type": "object",
      "properties": {
        "type": {
          "const": "error"
        },
        "action": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocol_version": {
          "const": 1
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "type",
        "action",
        "request_id",
        "protocol_version",
        "error"
      ],
      "additionalProperties": true
    },
    "socketEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "event"
        },
        "action": {
          "type": "string"
        },
        "protocol_version": {
          "const": 1
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "emitted_at": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "action",
        "protocol_version",
        "event_id",
        "emitted_at",
        "data"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "message_created",
                  "message_updated",
                  "message_deleted",
                  "send_message",
                  "edit_message",
                  "delete_message"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/mutationData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "fetch_messages"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/historyData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "chat_room_updated"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/room"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "set_typing",
                  "typing_updated"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/typingData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "mark_read",
                  "message_read",
                  "mark_delivered",
                  "message_delivered"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/receiptData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "react_to_message",
                  "message_reacted"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/reactionData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "access_revoked"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "chat_room_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "chat_room_id"
                ],
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "get_chat_rooms",
                  "chat_rooms_fetched"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "chat_rooms": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/room"
                    }
                  },
                  "next_cursor": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50
                  }
                },
                "required": [
                  "chat_rooms",
                  "next_cursor",
                  "limit"
                ],
                "additionalProperties": true
              }
            }
          }
        }
      ]
    },
    "socketAck": {
      "type": "object",
      "properties": {
        "type": {
          "const": "success"
        },
        "action": {
          "type": "string"
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocol_version": {
          "const": 1
        },
        "data": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "action",
        "request_id",
        "protocol_version",
        "data"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "message_created",
                  "message_updated",
                  "message_deleted",
                  "send_message",
                  "edit_message",
                  "delete_message"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/mutationData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "fetch_messages"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/historyData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "chat_room_updated"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/room"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "set_typing",
                  "typing_updated"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/typingData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "mark_read",
                  "message_read",
                  "mark_delivered",
                  "message_delivered"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/receiptData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "react_to_message",
                  "message_reacted"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/reactionData"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "access_revoked"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "chat_room_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "chat_room_id"
                ],
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "get_chat_rooms",
                  "chat_rooms_fetched"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "chat_rooms": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/room"
                    }
                  },
                  "next_cursor": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50
                  }
                },
                "required": [
                  "chat_rooms",
                  "next_cursor",
                  "limit"
                ],
                "additionalProperties": true
              }
            }
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "maxLength": 64
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "action",
        "payload"
      ],
      "additionalProperties": true
    },
    "mutationData": {
      "type": "object",
      "properties": {
        "message": {
          "$ref": "#/$defs/message"
        },
        "chat_room": {
          "anyOf": [
            {
              "$ref": "#/$defs/room"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": true
    },
    "typingData": {
      "type": "object",
      "properties": {
        "chat_room_id": {
          "type": "string",
          "format": "uuid"
        },
        "typing_users": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      },
      "required": [
        "chat_room_id",
        "typing_users"
      ],
      "additionalProperties": true
    },
    "receiptData": {
      "type": "object",
      "properties": {
        "chat_room_id": {
          "type": "string",
          "format": "uuid"
        },
        "message_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "required": [
        "chat_room_id",
        "message_ids"
      ],
      "additionalProperties": true
    },
    "reactionData": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "integer",
          "minimum": 1
        },
        "user_id": {
          "type": "integer",
          "minimum": 1
        },
        "reaction": {
          "type": [
            "string",
            "null"
          ]
        },
        "was_removed": {
          "type": "boolean"
        }
      },
      "required": [
        "message_id",
        "user_id",
        "reaction",
        "was_removed"
      ],
      "additionalProperties": true
    },
    "profileProgress": {
      "type": "object",
      "properties": {
        "phone_verified": {
          "type": "boolean"
        },
        "profile_complete": {
          "type": "boolean"
        },
        "next_step": {
          "enum": [
            "name",
            "photo",
            "complete"
          ]
        },
        "photo_skipped": {
          "type": "boolean"
        },
        "membership": {
          "enum": [
            "linked",
            "unlinked"
          ]
        },
        "couple_id": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "phone_verified",
        "profile_complete",
        "next_step",
        "photo_skipped",
        "membership",
        "couple_id"
      ],
      "additionalProperties": true
    },
    "authChallenge": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "challenge_id": {
              "type": "string"
            },
            "expires_at": {
              "type": "string"
            },
            "resend_at": {
              "type": "string"
            },
            "server_time": {
              "type": "string"
            },
            "retry_after_seconds": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "challenge_id",
            "expires_at",
            "resend_at",
            "server_time",
            "retry_after_seconds"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "data"
      ],
      "additionalProperties": true
    },
    "authProfile": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "user": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "full_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "username": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "profile_photo": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "is_phone_verified": {
                  "type": "boolean"
                },
                "is_profile_complete": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "full_name",
                "username",
                "profile_photo",
                "is_phone_verified",
                "is_profile_complete"
              ],
              "additionalProperties": true
            },
            "progress": {
              "$ref": "#/$defs/profileProgress"
            }
          },
          "required": [
            "user",
            "progress"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "data"
      ],
      "additionalProperties": true
    },
    "authTokens": {
      "type": "object",
      "properties": {
        "access": {
          "type": "string",
          "minLength": 1
        },
        "refresh": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "access",
        "refresh"
      ],
      "additionalProperties": true
    },
    "authVerified": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "tokens": {
              "$ref": "#/$defs/authTokens"
            },
            "user": {
              "type": "object"
            },
            "progress": {
              "$ref": "#/$defs/profileProgress"
            }
          },
          "required": [
            "tokens",
            "user",
            "progress"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "data"
      ],
      "additionalProperties": true
    },
    "authRefresh": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "tokens": {
              "$ref": "#/$defs/authTokens"
            }
          },
          "required": [
            "tokens"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "data"
      ],
      "additionalProperties": true
    },
    "coupleProfileData": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "viewer": {
          "enum": [
            "member",
            "visitor"
          ]
        },
        "can_edit": {
          "type": "boolean"
        },
        "can_fave": {
          "type": "boolean"
        },
        "can_view_moments": {
          "type": "boolean"
        },
        "is_faved": {
          "type": "boolean"
        },
        "published_sections": {
          "type": "array",
          "items": {
            "enum": [
              "identity",
              "story",
              "song",
              "interests",
              "cover",
              "date"
            ]
          },
          "uniqueItems": true
        },
        "visible_moment_count": {
          "type": "integer",
          "minimum": 0
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "name": {
                "type": "string"
              },
              "photo_url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "photo_url"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "maxItems": 2
        },
        "story": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "author_id": {
                "type": "integer",
                "minimum": 1
              },
              "prompt": {
                "enum": [
                  "how_met",
                  "first_move",
                  "first_impression"
                ]
              },
              "answer": {
                "type": "string",
                "maxLength": 240
              }
            },
            "required": [
              "author_id",
              "prompt",
              "answer"
            ],
            "additionalProperties": false
          },
          "maxItems": 6
        },
        "song": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "artist": {
              "type": "string"
            },
            "band": {
              "type": "string"
            },
            "note": {
              "type": "string"
            },
            "picked_by_id": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "title",
            "artist",
            "band",
            "note",
            "picked_by_id"
          ],
          "additionalProperties": false
        },
        "interests": {
          "type": "object",
          "properties": {
            "shared": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mine": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "partner": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "shared"
          ],
          "additionalProperties": false
        },
        "cover": {
          "type": "object",
          "properties": {
            "url": {
              "type": [
                "string",
                "null"
              ]
            },
            "focal_y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "url",
            "focal_y"
          ],
          "additionalProperties": false
        },
        "anniversary_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "days_together": {
          "type": "integer",
          "minimum": 0
        },
        "plan_count": {
          "type": "integer",
          "minimum": 0
        },
        "revisions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "sharing": {
          "type": "object",
          "properties": {
            "proposal": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "proposal_version": {
              "type": "integer"
            },
            "approved_by": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "valid_proposal": {
              "type": "boolean"
            }
          },
          "required": [
            "proposal",
            "proposal_version",
            "approved_by",
            "valid_proposal"
          ],
          "additionalProperties": false
        },
        "days_to_anniversary": {
          "type": "integer",
          "minimum": 0
        },
        "plans_done": {
          "type": "integer",
          "minimum": 0
        },
        "plans_upcoming": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "viewer",
        "can_edit",
        "can_fave",
        "can_view_moments",
        "is_faved",
        "published_sections",
        "visible_moment_count"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "viewer": {
                "const": "visitor"
              }
            }
          },
          "then": {
            "properties": {
              "can_edit": {
                "const": false
              },
              "interests": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "mine"
                      ]
                    },
                    {
                      "required": [
                        "partner"
                      ]
                    }
                  ]
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "revisions"
                  ]
                },
                {
                  "required": [
                    "sharing"
                  ]
                },
                {
                  "required": [
                    "plan_count"
                  ]
                },
                {
                  "required": [
                    "plans_done"
                  ]
                },
                {
                  "required": [
                    "plans_upcoming"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "coupleProfile": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/coupleProfileData"
        }
      },
      "required": [
        "message",
        "data"
      ],
      "additionalProperties": false
    },
    "couplePlanData": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "created_by": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "starts_at": {
          "type": "string",
          "format": "date-time"
        },
        "response": {
          "enum": [
            "pending",
            "yes",
            "no",
            "another_time"
          ]
        },
        "response_note": {
          "type": "string"
        },
        "completed": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "created_by",
        "title",
        "starts_at",
        "response",
        "response_note",
        "completed",
        "revision"
      ],
      "additionalProperties": false
    },
    "couplePlan": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/couplePlanData"
        }
      },
      "required": [
        "message",
        "data"
      ],
      "additionalProperties": false
    }
  }
}
