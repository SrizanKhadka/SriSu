{
  "openapi": "3.1.0",
  "info": {
    "title": "SriSu Couple Home",
    "version": "home-1",
    "description": "Additive daily-question assignment, private expiring statuses, and unscheduled date ideas. Existing Spark answer encryption and Plan consent contracts remain authoritative. No chat plaintext is accepted."
  },
  "paths": {
    "/api/social/sparks/daily/": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized original audience; private, no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyResponse"
                }
              }
            }
          },
          "401": {
            "description": "Sign in again"
          },
          "404": {
            "description": "Unavailable to this original audience"
          },
          "409": {
            "description": "Revision or operation conflict; refresh"
          },
          "429": {
            "description": "Rate limited; respect Retry-After"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DailyInput"
              }
            }
          }
        }
      }
    },
    "/api/social/couple-status/": {
      "get": {
        "security": [
