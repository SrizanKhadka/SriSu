            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized original audience; private, no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdeasResponse"
                }
              }
            }
          },
          "401": {
            "description": "Sign in again"
          },
          "404": {
            "description": "Unavailable to this original audience"
          },
          "409": {
            "description": "Revision or operation conflict; refresh"
          },
          "429": {
            "description": "Rate limited; respect Retry-After"
          }
        },
        "parameters": [
          {
            "name": "couple",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      },
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized original audience; private, no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdeaResponse"
                }
              }
            }
          },
          "401": {
            "description": "Sign in again"
          },
          "404": {
            "description": "Unavailable to this original audience"
          },
          "409": {
            "description": "Revision or operation conflict; refresh"
          },
          "429": {
            "description": "Rate limited; respect Retry-After"
          },
          "201": {
            "description": "Authorized original audience; private, no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdeaResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
